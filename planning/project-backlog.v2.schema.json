{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pqc-migration-reference-demo/planning/project-backlog.v2.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "PQC Assessment Project Backlog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "initiative",
    "classification",
    "sourceOfTruth",
    "planningBasis",
    "reportingCadences",
    "phases",
    "gates",
    "epics",
    "futureStateAppendix",
    "jiraProjection"
  ],
  "properties": {
    "schemaVersion": { "const": "pqc.project-backlog.v2" },
    "initiative": { "$ref": "#/$defs/initiative" },
    "classification": { "enum": ["public_template", "employer_confidential"] },
    "sourceOfTruth": { "const": "yaml" },
    "planningBasis": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/planningSource" }
    },
    "reportingCadences": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/reportingCadence" }
    },
    "reportingCycles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reportingCycle" }
    },
    "phases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/phase" }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "epics": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/epic" }
    },
    "futureStateAppendix": { "$ref": "#/$defs/futureStateAppendix" },
    "jiraProjection": { "$ref": "#/$defs/rootJiraProjection" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?=.*\\S)[^\\r\\n\\t]+$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?=.*\\S)[^\\r\\n\\t]+$"
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "refList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "status": {
      "enum": ["proposed", "ready", "in_progress", "blocked", "done", "accepted"]
    },
    "deliveryEvidenceStatus": {
      "enum": ["planned", "available", "collected", "validated", "accepted", "blocked", "unresolved"]
    },
    "frameworkProofLevel": {
      "enum": ["concept", "synthetic", "contract_tested", "live_readback", "closed_loop"]
    },
    "targetWindow": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "startWeek", "endWeek"],
          "properties": {
            "mode": { "const": "relative" },
            "startWeek": { "type": "integer", "minimum": 1, "maximum": 52 },
            "endWeek": { "type": "integer", "minimum": 1, "maximum": 52 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "startDate", "endDate"],
          "properties": {
            "mode": { "const": "calendar" },
            "startDate": { "type": "string", "format": "date" },
            "endDate": { "type": "string", "format": "date" }
          }
        }
      ]
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "boundaries", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^PQC-INIT-[0-9]{2}$" },
        "name": { "$ref": "#/$defs/shortText" },
        "purpose": { "$ref": "#/$defs/text" },
        "boundaries": { "$ref": "#/$defs/textList" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "planningSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "authority", "versionOrDate", "locatorPolicy", "evidenceStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "title": { "$ref": "#/$defs/shortText" },
        "authority": { "enum": ["engagement_source", "confirmed_project_decision", "internal_method", "external_guidance", "legacy_template"] },
        "versionOrDate": { "$ref": "#/$defs/shortText" },
        "locatorPolicy": { "enum": ["opaque", "private_local", "client_system"] },
        "evidenceStatus": { "enum": ["verified", "partially_verified", "probable", "assumption", "unresolved"] },
        "supersedesSourceRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "reportingCadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "cadence", "phaseRefs", "ownerRole", "audienceRoles", "requiredSections", "dueRule", "projection", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^RC-[A-Z0-9-]+$" },
        "name": { "$ref": "#/$defs/shortText" },
        "cadence": { "enum": ["every_two_weeks", "monthly", "per_phase"] },
        "intervalWeeks": { "type": "integer", "minimum": 1, "maximum": 8 },
        "phaseRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["P1", "P2"] }
        },
        "ownerRole": { "$ref": "#/$defs/shortText" },
        "audienceRoles": { "$ref": "#/$defs/textList" },
        "requiredSections": { "$ref": "#/$defs/textList" },
        "dueRule": { "enum": ["last_business_day", "preceding_business_day_if_closed", "phase_review_date"] },
        "projection": { "enum": ["recurring_work_item", "deliverable", "none"] },
        "sourceRefs": { "$ref": "#/$defs/refList" },
        "supersedesSourceRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "reportingCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "phaseRef", "startDate", "endDate", "reportDueDate"],
      "properties": {
        "id": { "type": "string", "pattern": "^C(?:0[1-9]|[1-9][0-9])$" },
        "name": { "$ref": "#/$defs/shortText" },
        "phaseRef": { "enum": ["P1", "P2"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "reportDueDate": { "type": "string", "format": "date" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "objective", "planningLevel", "targetWindow", "deliverables", "entryCriteria", "completionCriteria", "status"],
      "properties": {
        "id": { "enum": ["P1", "P2"] },
        "name": { "$ref": "#/$defs/shortText" },
        "objective": { "$ref": "#/$defs/text" },
        "planningLevel": { "enum": ["detailed", "outline"] },
        "targetWindow": { "$ref": "#/$defs/targetWindow" },
        "deliverables": { "$ref": "#/$defs/textList" },
        "entryCriteria": { "$ref": "#/$defs/textList" },
        "completionCriteria": { "$ref": "#/$defs/textList" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "phaseRefs", "completionCriteria", "requiredEvidence", "decisionOwnerRoles", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^PQC-(?:G[0-9]{2}|P[12]-G[0-9]{2})$" },
        "name": { "$ref": "#/$defs/shortText" },
        "purpose": { "$ref": "#/$defs/text" },
        "phaseRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["P1", "P2"] }
        },
        "completionCriteria": { "$ref": "#/$defs/textList" },
        "requiredEvidence": { "$ref": "#/$defs/textList" },
        "decisionOwnerRoles": { "$ref": "#/$defs/textList" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excludedWork", "authorityLimits", "dataHandlingConstraints", "evidenceConstraints"],
      "properties": {
        "excludedWork": { "$ref": "#/$defs/textList" },
        "authorityLimits": { "$ref": "#/$defs/textList" },
        "dataHandlingConstraints": { "$ref": "#/$defs/textList" },
        "evidenceConstraints": { "$ref": "#/$defs/textList" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "acceptanceCriteria", "requiredEvidence", "decisionOwnerRoles"],
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "acceptanceCriteria": { "$ref": "#/$defs/textList" },
        "requiredEvidence": { "$ref": "#/$defs/textList" },
        "decisionOwnerRoles": { "$ref": "#/$defs/textList" }
      }
    },
    "frameworkCrosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameworkId", "authority", "referenceIds", "relationship", "note"],
      "properties": {
        "frameworkId": { "type": "string", "pattern": "^FW-[A-Z0-9-]+$" },
        "authority": { "enum": ["engagement_source", "internal_method", "external_guidance"] },
        "referenceIds": { "$ref": "#/$defs/refList" },
        "relationship": { "enum": ["direct", "supports", "prerequisite", "deferred", "excluded"] },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "deliveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requiredArtifacts", "basisRefs"],
      "properties": {
        "status": { "$ref": "#/$defs/deliveryEvidenceStatus" },
        "requiredArtifacts": { "$ref": "#/$defs/textList" },
        "basisRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "frameworkProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentLevel", "targetLevel", "basisRefs"],
      "properties": {
        "currentLevel": { "$ref": "#/$defs/frameworkProofLevel" },
        "targetLevel": { "$ref": "#/$defs/frameworkProofLevel" },
        "basisRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "storyJiraProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueType", "parentPlanningId", "fixVersion", "labels", "component", "excluded"],
      "properties": {
        "issueType": { "enum": ["Story", "Task"] },
        "parentPlanningId": { "type": "string", "pattern": "^PQC-(?:E00|P[12]-E[0-9]{2})$" },
        "fixVersion": { "$ref": "#/$defs/shortText" },
        "labels": { "$ref": "#/$defs/refList" },
        "component": { "$ref": "#/$defs/shortText" },
        "excluded": { "const": false }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "outcome",
        "description",
        "includedScope",
        "excludedScope",
        "acceptanceCriteria",
        "deliverables",
        "dependencies",
        "gateRefs",
        "ownerRole",
        "reviewerRoles",
        "targetWindow",
        "sourceRefs",
        "status",
        "deliveryEvidence",
        "jiraProjection",
        "legacyRefs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^PQC-(?:E00|P[12]-E[0-9]{2})-S0[1-3]$" },
        "summary": { "$ref": "#/$defs/shortText" },
        "outcome": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "includedScope": { "$ref": "#/$defs/textList" },
        "excludedScope": { "$ref": "#/$defs/textList" },
        "acceptanceCriteria": { "$ref": "#/$defs/textList" },
        "deliverables": { "$ref": "#/$defs/textList" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^PQC-(?:E00|P[12]-E[0-9]{2})-S0[1-3]$" }
        },
        "gateRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^PQC-(?:G[0-9]{2}|P[12]-G[0-9]{2})$" }
        },
        "ownerRole": { "$ref": "#/$defs/shortText" },
        "reviewerRoles": { "$ref": "#/$defs/textList" },
        "targetWindow": { "$ref": "#/$defs/targetWindow" },
        "sourceRefs": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/status" },
        "deliveryEvidence": { "$ref": "#/$defs/deliveryEvidence" },
        "frameworkProof": { "$ref": "#/$defs/frameworkProof" },
        "jiraProjection": { "$ref": "#/$defs/storyJiraProjection" },
        "legacyGroup": { "$ref": "#/$defs/shortText" },
        "legacyRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phaseRef",
        "name",
        "purpose",
        "includedWork",
        "boundaries",
        "completion",
        "targetWindow",
        "dependencies",
        "gateRefs",
        "ownerRole",
        "reviewerRoles",
        "frameworkCrosswalk",
        "stories",
        "status",
        "legacyRefs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^PQC-(?:E00|P[12]-E[0-9]{2})$" },
        "phaseRef": { "enum": ["CROSS", "P1", "P2"] },
        "name": { "$ref": "#/$defs/shortText" },
        "purpose": { "$ref": "#/$defs/text" },
        "includedWork": { "$ref": "#/$defs/textList" },
        "boundaries": { "$ref": "#/$defs/boundaries" },
        "completion": { "$ref": "#/$defs/completion" },
        "targetWindow": { "$ref": "#/$defs/targetWindow" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^PQC-(?:E00|P[12]-E[0-9]{2})$" }
        },
        "gateRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^PQC-(?:G[0-9]{2}|P[12]-G[0-9]{2})$" }
        },
        "ownerRole": { "$ref": "#/$defs/shortText" },
        "reviewerRoles": { "$ref": "#/$defs/textList" },
        "frameworkCrosswalk": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/frameworkCrosswalk" }
        },
        "stories": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/story" }
        },
        "status": { "$ref": "#/$defs/status" },
        "legacyRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "futureStateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rationale", "futureEntryCriteria", "legacyRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^FUT-[0-9]{2}$" },
        "name": { "$ref": "#/$defs/shortText" },
        "rationale": { "$ref": "#/$defs/text" },
        "futureEntryCriteria": { "$ref": "#/$defs/textList" },
        "legacyRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "futureStateAppendix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "boundaries", "jiraProjection", "futureAuthorizationRequired", "items"],
      "properties": {
        "purpose": { "$ref": "#/$defs/text" },
        "boundaries": { "$ref": "#/$defs/textList" },
        "jiraProjection": { "const": false },
        "futureAuthorizationRequired": { "const": true },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/futureStateItem" }
        }
      }
    },
    "rootJiraProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "hierarchy", "phaseMapping", "initiativeFallback", "excludeFutureStateAppendix"],
      "properties": {
        "authority": { "const": "projection_only" },
        "hierarchy": { "const": "Initiative>Epic>Story" },
        "phaseMapping": { "enum": ["fix_version", "label", "component"] },
        "initiativeFallback": { "enum": ["fix_version", "label", "omit_initiative_row"] },
        "excludeFutureStateAppendix": { "const": true }
      }
    }
  }
}
