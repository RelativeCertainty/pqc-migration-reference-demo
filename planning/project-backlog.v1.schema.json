{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pqc-migration-reference-demo/planning/project-backlog.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "PQC Project Backlog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "program", "sourceOfTruth", "rollingWaveWeeks", "epics"],
  "properties": {
    "schemaVersion": { "const": "pqc.project-backlog.v1" },
    "program": { "type": "string", "minLength": 1 },
    "sourceOfTruth": { "const": "yaml" },
    "rollingWaveWeeks": { "const": 2 },
    "epics": {
      "type": "array",
      "items": { "$ref": "#/$defs/epic" }
    }
  },
  "$defs": {
    "status": { "enum": ["proposed", "ready", "in_progress", "blocked", "done", "accepted"] },
    "evidence": { "enum": ["concept", "synthetic", "contract-tested", "live-readback", "closed-loop"] },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "acceptanceCriteria", "dependencies", "evidence", "risk", "gate", "ownerRole", "status", "targetIteration"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[1-7]\\.[1-9][0-9]*\\.[1-9][0-9]*$" },
        "outcome": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "evidence": { "$ref": "#/$defs/evidence" },
        "risk": { "enum": ["low", "moderate", "high", "critical"] },
        "gate": { "type": "string", "pattern": "^G[1-7]$" },
        "ownerRole": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "targetIteration": { "type": "string", "pattern": "^W(?:[1-9]|1[0-2])(?:-(?:[1-9]|1[0-2]))?$" }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stories"],
      "properties": {
        "id": { "type": "string", "pattern": "^F[1-7]\\.[1-9][0-9]*$" },
        "name": { "type": "string", "minLength": 1 },
        "stories": { "type": "array", "items": { "$ref": "#/$defs/story" } }
      }
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weeks", "gateAcceptance", "features"],
      "properties": {
        "id": { "type": "string", "pattern": "^E[1-7]$" },
        "name": { "type": "string", "minLength": 1 },
        "weeks": { "type": "string", "pattern": "^W[1-9][0-2]?(?:-[1-9][0-2]?)?$" },
        "gateAcceptance": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
      }
    }
  }
}
