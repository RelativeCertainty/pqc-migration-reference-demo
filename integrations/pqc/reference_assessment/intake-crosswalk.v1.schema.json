{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pqc/intake-crosswalk.v1.schema.json",
  "title": "PQC intake questionnaire to runtime-family classification crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "crosswalk_id", "status", "source_catalog", "runtime_catalog", "relationship_definitions", "rules", "rfi_profiles", "unmapped_runtime_families", "limitations"],
  "properties": {
    "schema_version": {"const": "pba.pqc.intake-catalog-crosswalk.v1"},
    "crosswalk_id": {"type": "string", "pattern": "^intake-rfi-runtime-[0-9]{8}-v[1-9][0-9]*$"},
    "status": {"const": "development_classification_mapping_requires_review"},
    "source_catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "snapshot_scope", "profile_count"],
      "properties": {
        "reference": {"const": "pqc-source-discovery-rfi-catalog.v1.yaml"},
        "snapshot_scope": {"const": "classification_ids_and_labels_only_no_answers_or_enterprise_instances"},
        "profile_count": {"const": 27}
      }
    },
    "runtime_catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "schema_version", "sha256", "family_count"],
      "properties": {
        "reference": {"const": "catalog.v1.json"},
        "schema_version": {"const": "pba.pqc.reference-qualification-catalog.v1"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "family_count": {"const": 27}
      }
    },
    "relationship_definitions": {
      "type": "object", "additionalProperties": false,
      "required": ["exact", "partial", "overlap", "unmapped"],
      "properties": {"exact": {"$ref": "#/$defs/text"}, "partial": {"$ref": "#/$defs/text"}, "overlap": {"$ref": "#/$defs/text"}, "unmapped": {"$ref": "#/$defs/text"}}
    },
    "rules": {"$ref": "#/$defs/nonemptyTexts"},
    "limitations": {"$ref": "#/$defs/nonemptyTexts"},
    "rfi_profiles": {
      "type": "array", "minItems": 27, "maxItems": 27,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "mappings", "unresolved_aspects"],
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-RFI-0(0[1-9]|1[0-9]|2[0-7])$"},
          "label": {"$ref": "#/$defs/text"},
          "mappings": {
            "type": "array", "minItems": 1, "maxItems": 27,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["family_id", "relationship", "rationale"],
              "properties": {
                "family_id": {"$ref": "#/$defs/familyId"},
                "relationship": {"enum": ["exact", "partial", "overlap"]},
                "rationale": {"$ref": "#/$defs/text"}
              }
            }
          },
          "unresolved_aspects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "unmapped_runtime_families": {
      "type": "array", "minItems": 1, "maxItems": 27,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family_id", "relationship", "reason", "next_action"],
        "properties": {
          "family_id": {"$ref": "#/$defs/familyId"},
          "relationship": {"const": "unmapped"},
          "reason": {"$ref": "#/$defs/text"},
          "next_action": {"$ref": "#/$defs/text"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "familyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$"},
    "nonemptyTexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
