{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pqc/reference-qualification-catalog-expansion.v2.schema.json",
  "title": "PQC reference qualification catalog v2 expansion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "examples_status",
    "addition_status",
    "base_catalog",
    "current_catalog",
    "historical_questionnaire_boundary",
    "source_family_additions",
    "migration_archetype_ref_additions"
  ],
  "properties": {
    "schema_version": {
      "const": "pba.pqc.reference-qualification-catalog-expansion.v2"
    },
    "status": {
      "const": "development_reference_addition_not_enterprise_selection"
    },
    "examples_status": {
      "const": "recognition_examples_not_installed_or_selected"
    },
    "addition_status": {
      "const": "recognition_only_no_qualified_adapter_or_execution_authority"
    },
    "base_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "sha256", "source_family_count"],
      "properties": {
        "path": {"const": "catalog.v1.json"},
        "schema_version": {"const": "pba.pqc.reference-qualification-catalog.v1"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_family_count": {"const": 27}
      }
    },
    "current_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_family_count"],
      "properties": {
        "schema_version": {"const": "pba.pqc.reference-qualification-catalog.v2"},
        "source_family_count": {"const": 28}
      }
    },
    "historical_questionnaire_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosswalk_path",
        "crosswalk_schema_version",
        "profile_count",
        "dispatch_state",
        "new_family_match"
      ],
      "properties": {
        "crosswalk_path": {"const": "intake-crosswalk.v1.json"},
        "crosswalk_schema_version": {"const": "pba.pqc.intake-catalog-crosswalk.v1"},
        "profile_count": {"const": 27},
        "dispatch_state": {"const": "historical_questionnaires_and_distribution_unchanged"},
        "new_family_match": {"const": "no_legacy_questionnaire_match"}
      }
    },
    "source_family_additions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/sourceFamilyAddition"}
    },
    "migration_archetype_ref_additions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archetype_id", "source_family_refs"],
        "properties": {
          "archetype_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          },
          "source_family_refs": {
            "const": ["virtualization-hypervisors"]
          }
        }
      }
    }
  },
  "$defs": {
    "sourceFamilyAddition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "lineage"],
      "properties": {
        "family": {"$ref": "#/$defs/sourceFamily"},
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_questionnaire_match",
            "legacy_profile_id",
            "adapter_qualification",
            "execution_authorized"
          ],
          "properties": {
            "legacy_questionnaire_match": {"const": "none"},
            "legacy_profile_id": {"type": "null"},
            "adapter_qualification": {"const": "not_qualified"},
            "execution_authorized": {"const": false}
          }
        }
      }
    },
    "sourceFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area_ref",
        "name",
        "recognition_examples",
        "discovery_question",
        "evidence_targets",
        "pattern_refs",
        "product_profile"
      ],
      "properties": {
        "id": {"const": "virtualization-hypervisors"},
        "area_ref": {"const": "area-06"},
        "name": {"const": "Virtualization and hypervisor platforms"},
        "recognition_examples": {
          "const": [
            "VMware vSphere (ESXi and vCenter)",
            "Microsoft Hyper-V and System Center Virtual Machine Manager"
          ]
        },
        "discovery_question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "pattern_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,79}$"
          }
        },
        "product_profile": {"$ref": "#/$defs/unknownProductProfile"}
      }
    },
    "unknownProductProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "product",
        "edition",
        "version",
        "instance",
        "approved_interface",
        "authentication",
        "minimum_permissions",
        "licensing",
        "pagination",
        "deletion_semantics",
        "rate_limits",
        "write_idempotency"
      ],
      "properties": {
        "status": {"const": "unknown_requires_owner_and_vendor_confirmation"},
        "product": {"type": "null"},
        "edition": {"type": "null"},
        "version": {"type": "null"},
        "instance": {"type": "null"},
        "approved_interface": {"type": "null"},
        "authentication": {"type": "null"},
        "minimum_permissions": {"type": "null"},
        "licensing": {"type": "null"},
        "pagination": {"type": "null"},
        "deletion_semantics": {"type": "null"},
        "rate_limits": {"type": "null"},
        "write_idempotency": {"type": "null"}
      }
    }
  }
}
