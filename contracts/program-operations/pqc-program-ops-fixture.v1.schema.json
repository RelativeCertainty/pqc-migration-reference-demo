{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/program-operations/pqc-program-ops-fixture.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "PQC Program Operations Synthetic Fixture v1",
  "description": "Aggregate reference fixture for the local read-only API and MCP server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceStatus", "asOf", "program", "operatingStandard", "implementationProfile", "projectDays", "dailyLogEntries", "workSessions", "timeEntries", "dailySnapshots", "stakeholderUpdates", "actions", "dependencies", "rfis", "decisions", "gates", "reports", "externalReferences", "manual"],
  "properties": {
    "schemaVersion": {"const": "pqc.program-operations-fixture.v1"},
    "evidenceStatus": {"const": "synthetic"},
    "asOf": {"$ref": "program-operations-common.v1.schema.json#/$defs/timestamp"},
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programId", "name", "purpose", "status", "phase", "cycle", "startDate", "targetEndDate"],
      "properties": {
        "programId": {"$ref": "program-operations-common.v1.schema.json#/$defs/identifier"},
        "name": {"$ref": "program-operations-common.v1.schema.json#/$defs/plainLanguageName"},
        "purpose": {"type": "string", "minLength": 10},
        "status": {"type": "string", "enum": ["planning", "active", "on_hold", "completed", "cancelled"]},
        "phase": {"$ref": "program-operations-common.v1.schema.json#/$defs/identifier"},
        "cycle": {"$ref": "program-operations-common.v1.schema.json#/$defs/identifier"},
        "startDate": {"$ref": "program-operations-common.v1.schema.json#/$defs/date"},
        "targetEndDate": {"$ref": "program-operations-common.v1.schema.json#/$defs/date"}
      }
    },
    "operatingStandard": {"$ref": "pqc-program-operating-standard.v1.schema.json"},
    "implementationProfile": {"$ref": "pqc-program-implementation-profile.v1.schema.json"},
    "projectDays": {"type": "array", "items": {"$ref": "project-day.v1.schema.json"}},
    "dailyLogEntries": {"type": "array", "items": {"$ref": "daily-log-entry.v1.schema.json"}},
    "workSessions": {"type": "array", "items": {"$ref": "work-session.v1.schema.json"}},
    "timeEntries": {"type": "array", "items": {"$ref": "time-entry.v1.schema.json"}},
    "dailySnapshots": {"type": "array", "items": {"$ref": "daily-status-snapshot.v1.schema.json"}},
    "stakeholderUpdates": {"type": "array", "items": {"$ref": "stakeholder-update.v1.schema.json"}},
    "actions": {"type": "array", "items": {"$ref": "program-action.v1.schema.json"}},
    "dependencies": {"type": "array", "items": {"$ref": "program-dependency.v1.schema.json"}},
    "rfis": {"type": "array", "items": {"$ref": "rfi-record.v1.schema.json"}},
    "decisions": {"type": "array", "items": {"$ref": "program-decision.v1.schema.json"}},
    "gates": {"type": "array", "items": {"$ref": "gate-assessment.v1.schema.json"}},
    "reports": {"type": "array", "items": {"$ref": "program-report-snapshot.v1.schema.json"}},
    "externalReferences": {"type": "array", "items": {"$ref": "external-reference-binding.v1.schema.json"}},
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "path", "summary"],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 3},
        "summary": {"type": "string", "minLength": 10}
      }
    }
  }
}
