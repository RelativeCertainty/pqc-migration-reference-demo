{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RelativeCertainty/pqc-migration-reference-demo/contracts/evidence-fusion-result.v1.schema.json",
  "title": "PQC Evidence Fusion Result v1",
  "description": "Versioned outbound result port for canonical cryptographic records and disputed source identities that require reconciliation. Disputed variants are excluded from canonical evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records",
    "sourceReconciliationQueue"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pqc.evidence-fusion-result.v1"
    },
    "records": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "canonical-crypto-record.v1.schema.json"
      }
    },
    "sourceReconciliationQueue": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceReconciliationItem"
      }
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "sourceIdentityRef": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^source-identity:local:[0-9]{4}$"
    },
    "feedId": {
      "enum": [
        "initial-inventory",
        "extrahop-internet-tls",
        "vulnerability-manager",
        "pki-inventory",
        "sast",
        "cmdb"
      ]
    },
    "conflictFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replayOrdinal",
        "observationId",
        "feedId",
        "sourceIdentityRef",
        "conflictFields",
        "duplicateSubmissionCount",
        "trustedCanonicalContribution"
      ],
      "properties": {
        "replayOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "observationId": {
          "$ref": "#/$defs/safeIdentifier"
        },
        "feedId": {
          "$ref": "#/$defs/feedId"
        },
        "sourceIdentityRef": {
          "$ref": "#/$defs/sourceIdentityRef"
        },
        "conflictFields": {
          "$ref": "#/$defs/conflictFields"
        },
        "duplicateSubmissionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "trustedCanonicalContribution": {
          "const": false
        }
      }
    },
    "sourceReconciliationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIdentityRef",
        "feedId",
        "conflictFields",
        "variants",
        "review"
      ],
      "properties": {
        "sourceIdentityRef": {
          "$ref": "#/$defs/sourceIdentityRef"
        },
        "feedId": {
          "$ref": "#/$defs/feedId"
        },
        "conflictFields": {
          "$ref": "#/$defs/conflictFields"
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "reasons"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "reasons": {
              "const": [
                "Disputed source identity is excluded from canonical evidence"
              ]
            }
          }
        }
      }
    }
  }
}
