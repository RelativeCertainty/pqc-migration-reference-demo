{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/dashboard-projection.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "DashboardProjection.v1",
  "description": "A rebuildable, read-only Phase 1 dashboard projection with explicit scope and denominator semantics. It is not an audit ledger or an execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectionId",
    "tenantId",
    "scope",
    "definitionRefs",
    "authoritativeAsOfAt",
    "generatedAt",
    "sourceReadiness",
    "authorizedEstateCoverage",
    "evidenceFreshness",
    "correlationConfidence",
    "evidenceLimitations",
    "projectionLag",
    "claims",
    "safety"
  ],
  "properties": {
    "schemaVersion": { "const": "DashboardProjection.v1" },
    "projectionId": { "$ref": "#/$defs/identifier" },
    "tenantId": { "$ref": "#/$defs/identifier" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeRef", "scopeLabel", "regionRefs", "denominatorBoundary"],
      "properties": {
        "scopeRef": { "$ref": "#/$defs/identifier" },
        "scopeLabel": { "$ref": "#/$defs/plainText" },
        "regionRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "denominatorBoundary": { "$ref": "#/$defs/plainText" }
      }
    },
    "definitionRefs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "authoritativeAsOfAt": { "$ref": "#/$defs/timestamp" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "sourceReadiness": { "$ref": "#/$defs/ratioMetric" },
    "authorizedEstateCoverage": {
      "allOf": [
        { "$ref": "#/$defs/ratioMetric" },
        {
          "type": "object",
          "required": ["denominatorSourceRef"],
          "properties": {
            "denominatorSourceRef": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "evidenceFreshness": {
      "allOf": [
        { "$ref": "#/$defs/ratioMetric" },
        {
          "type": "object",
          "required": ["thresholdSeconds", "oldestEligibleObservationAt"],
          "properties": {
            "thresholdSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
            "oldestEligibleObservationAt": { "$ref": "#/$defs/timestamp" }
          }
        }
      ]
    },
    "correlationConfidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricDefinitionRef", "status", "eligibleCount", "counts", "highConfidenceFraction", "qualification"],
      "properties": {
        "metricDefinitionRef": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["available", "unavailable"] },
        "eligibleCount": { "type": "integer", "minimum": 0 },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "moderate", "low", "unresolved"],
          "properties": {
            "high": { "type": "integer", "minimum": 0 },
            "moderate": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 },
            "unresolved": { "type": "integer", "minimum": 0 }
          }
        },
        "highConfidenceFraction": {
          "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
        },
        "qualification": { "$ref": "#/$defs/plainText" }
      }
    },
    "evidenceLimitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricDefinitionRef", "openCount", "blockingCount", "limitationRefs", "qualification"],
      "properties": {
        "metricDefinitionRef": { "$ref": "#/$defs/identifier" },
        "openCount": { "type": "integer", "minimum": 0 },
        "blockingCount": { "type": "integer", "minimum": 0 },
        "limitationRefs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "qualification": { "$ref": "#/$defs/plainText" }
      }
    },
    "projectionLag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricDefinitionRef", "status", "seconds", "qualification"],
      "properties": {
        "metricDefinitionRef": { "$ref": "#/$defs/identifier" },
        "status": { "const": "available" },
        "seconds": { "type": "integer", "minimum": 0 },
        "qualification": { "$ref": "#/$defs/plainText" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enterpriseCompletenessClaimed", "riskConclusionClaimed", "migrationCompletionClaimed", "productionStateClaimed"],
      "properties": {
        "enterpriseCompletenessClaimed": { "const": false },
        "riskConclusionClaimed": { "const": false },
        "migrationCompletionClaimed": { "const": false },
        "productionStateClaimed": { "const": false }
      }
    },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-z0-9][a-z0-9._:-]+$"
    },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\r\\n\\t]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "ratioMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricDefinitionRef", "status", "numerator", "denominator", "fraction", "qualification"],
      "properties": {
        "metricDefinitionRef": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["available", "unavailable"] },
        "numerator": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "denominator": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "fraction": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
        "qualification": { "$ref": "#/$defs/plainText" },
        "denominatorSourceRef": { "$ref": "#/$defs/identifier" },
        "thresholdSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "oldestEligibleObservationAt": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] },
          "then": {
            "properties": {
              "numerator": { "type": "integer", "minimum": 0 },
              "denominator": { "type": "integer", "minimum": 1 },
              "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "else": {
            "properties": {
              "numerator": { "type": "null" },
              "denominator": { "type": "null" },
              "fraction": { "type": "null" }
            }
          }
        }
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "rebuildableProjection", "rawPayloadEmbedded", "secretMaterialEmbedded"],
      "properties": {
        "synthetic": { "const": true },
        "rebuildableProjection": { "const": true },
        "rawPayloadEmbedded": { "const": false },
        "secretMaterialEmbedded": { "const": false }
      }
    }
  }
}
