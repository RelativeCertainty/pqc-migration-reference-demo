{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/workflow-kernel/command-envelope.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "CommandEnvelope.v1",
  "description": "Safe command metadata for one bounded worker attempt. Inputs remain content-addressed artifact references; unrestricted payloads are not embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "tenantId", "workflowInstanceRef", "stepExecutionRef", "commandName", "capability", "correlationId", "causationId", "idempotencyKey", "expectedWorkflowRevision", "inputArtifactRefs", "argumentsDigest", "maximumAttempts", "notBefore", "expiresAt", "traceparent", "safety"],
  "properties": {
    "schemaVersion": {"const": "CommandEnvelope.v1"},
    "commandId": {"$ref": "#/$defs/identifier"},
    "tenantId": {"$ref": "#/$defs/identifier"},
    "workflowInstanceRef": {"$ref": "#/$defs/identifier"},
    "stepExecutionRef": {"$ref": "#/$defs/identifier"},
    "commandName": {"type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[a-z][a-z0-9_]+$"},
    "capability": {"type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[a-z][a-z0-9_.]+$"},
    "correlationId": {"$ref": "#/$defs/identifier"},
    "causationId": {"$ref": "#/$defs/identifier"},
    "idempotencyKey": {"$ref": "#/$defs/identifier"},
    "expectedWorkflowRevision": {"type": "integer", "minimum": 1},
    "inputArtifactRefs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "argumentsDigest": {"$ref": "#/$defs/digest"},
    "maximumAttempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "notBefore": {"$ref": "#/$defs/timestamp"},
    "expiresAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "traceparent": {"oneOf": [{"type": "string", "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$"}, {"type": "null"}]},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "maxLength": 30, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["synthetic", "payloadEmbedded", "credentialValueEmbedded", "privateKeyEmbedded"],
      "properties": {"synthetic": {"type": "boolean"}, "payloadEmbedded": {"const": false}, "credentialValueEmbedded": {"const": false}, "privateKeyEmbedded": {"const": false}}
    }
  }
}
