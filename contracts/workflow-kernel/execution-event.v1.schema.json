{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/workflow-kernel/execution-event.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "ExecutionEvent.v1",
  "description": "Append-only workflow execution event bound to correlation, causation, and a content digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionEventId", "tenantId", "workflowInstanceRef", "stepExecutionRef", "workerRunRef", "sequence", "eventType", "fromStatus", "toStatus", "correlationId", "causationId", "occurredAt", "eventDigest", "safety"],
  "properties": {
    "schemaVersion": {"const": "ExecutionEvent.v1"},
    "executionEventId": {"$ref": "#/$defs/identifier"},
    "tenantId": {"$ref": "#/$defs/identifier"},
    "workflowInstanceRef": {"$ref": "#/$defs/identifier"},
    "stepExecutionRef": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "workerRunRef": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "eventType": {"enum": ["workflow_created", "status_transition", "step_started", "step_completed", "command_enqueued", "retry_scheduled", "quarantined", "reconciliation_required", "workflow_completed"]},
    "fromStatus": {"oneOf": [{"type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-z][a-z_]+$"}, {"type": "null"}]},
    "toStatus": {"type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-z][a-z_]+$"},
    "correlationId": {"$ref": "#/$defs/identifier"},
    "causationId": {"$ref": "#/$defs/identifier"},
    "occurredAt": {"$ref": "#/$defs/timestamp"},
    "eventDigest": {"$ref": "#/$defs/digest"},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "maxLength": 30, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["synthetic", "payloadEmbedded", "credentialValueEmbedded", "privateKeyEmbedded"],
      "properties": {"synthetic": {"type": "boolean"}, "payloadEmbedded": {"const": false}, "credentialValueEmbedded": {"const": false}, "privateKeyEmbedded": {"const": false}}
    }
  }
}
