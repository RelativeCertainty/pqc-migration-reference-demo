{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/workflow-kernel/message-receipt.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "MessageReceipt.v1",
  "description": "Durable inbox receipt used to suppress duplicate message and idempotency effects without retaining a message payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageReceiptId", "tenantId", "messageId", "idempotencyKey", "messageDigest", "receivedAt", "disposition", "originalReceiptRef", "safety"],
  "properties": {
    "schemaVersion": {"const": "MessageReceipt.v1"},
    "messageReceiptId": {"$ref": "#/$defs/identifier"},
    "tenantId": {"$ref": "#/$defs/identifier"},
    "messageId": {"$ref": "#/$defs/identifier"},
    "idempotencyKey": {"$ref": "#/$defs/identifier"},
    "messageDigest": {"$ref": "#/$defs/digest"},
    "receivedAt": {"$ref": "#/$defs/timestamp"},
    "disposition": {"enum": ["admitted", "duplicate", "quarantined"]},
    "originalReceiptRef": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "duplicate"}}, "required": ["disposition"]},
      "then": {"properties": {"originalReceiptRef": {"$ref": "#/$defs/identifier"}}},
      "else": {"properties": {"originalReceiptRef": {"type": "null"}}}
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "maxLength": 30, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["synthetic", "payloadEmbedded", "credentialValueEmbedded", "privateKeyEmbedded"],
      "properties": {"synthetic": {"type": "boolean"}, "payloadEmbedded": {"const": false}, "credentialValueEmbedded": {"const": false}, "privateKeyEmbedded": {"const": false}}
    }
  }
}
