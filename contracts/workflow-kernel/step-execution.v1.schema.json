{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/workflow-kernel/step-execution.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "StepExecution.v1",
  "description": "State of one logical workflow step. Individual attempts remain append-only WorkerRun records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stepExecutionId", "tenantId", "workflowInstanceRef", "stepName", "status", "expectedWorkflowRevision", "attemptCount", "workerRunRefs", "startedAt", "finishedAt", "lastRetryClassification", "safety"],
  "properties": {
    "schemaVersion": {"const": "StepExecution.v1"},
    "stepExecutionId": {"$ref": "#/$defs/identifier"},
    "tenantId": {"$ref": "#/$defs/identifier"},
    "workflowInstanceRef": {"$ref": "#/$defs/identifier"},
    "stepName": {"type": "string", "minLength": 3, "maxLength": 100, "pattern": "^[a-z][a-z0-9_]+$"},
    "status": {"enum": ["pending", "running", "waiting", "succeeded", "failed", "quarantined", "skipped", "compensated"]},
    "expectedWorkflowRevision": {"type": "integer", "minimum": 1},
    "attemptCount": {"type": "integer", "minimum": 0, "maximum": 1000},
    "workerRunRefs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "startedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "finishedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "lastRetryClassification": {"enum": ["none", "rate_limited", "timeout", "transient_provider_error", "authentication", "authorization", "configuration", "schema_drift", "unknown_outcome"]},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["succeeded", "failed", "quarantined", "skipped", "compensated"]}}, "required": ["status"]},
      "then": {"properties": {"finishedAt": {"$ref": "#/$defs/timestamp"}}}
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "timestamp": {"type": "string", "format": "date-time", "maxLength": 30, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["synthetic", "payloadEmbedded", "credentialValueEmbedded", "privateKeyEmbedded"],
      "properties": {"synthetic": {"type": "boolean"}, "payloadEmbedded": {"const": false}, "credentialValueEmbedded": {"const": false}, "privateKeyEmbedded": {"const": false}}
    }
  }
}
