{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/source-event.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "SourceEvent.v1",
  "description": "Immutable ledger receipt for one provider page, event, or readback. Provider payload bytes remain in encrypted artifact custody and are never embedded in this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceEventId",
    "tenantId",
    "integrationProfileRef",
    "collectionRunRef",
    "eventKind",
    "providerRecordRef",
    "collectedAt",
    "artifact",
    "admission",
    "safety"
  ],
  "properties": {
    "schemaVersion": { "const": "SourceEvent.v1" },
    "sourceEventId": { "$ref": "#/$defs/identifier" },
    "tenantId": { "$ref": "#/$defs/identifier" },
    "integrationProfileRef": { "$ref": "#/$defs/identifier" },
    "collectionRunRef": { "$ref": "#/$defs/identifier" },
    "eventKind": {
      "enum": ["snapshot_page", "incremental_event", "record_readback", "approved_export"]
    },
    "providerRecordRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*\\S)[^\\r\\n\\t]+$"
    },
    "providerOccurredAt": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "collectedAt": { "$ref": "#/$defs/timestamp" },
    "artifact": { "$ref": "#/$defs/artifactReceipt" },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCodes"],
      "properties": {
        "status": { "enum": ["admitted", "quarantined", "duplicate"] },
        "reasonCodes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        }
      }
    },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact": {
            "properties": {
              "secretAssessment": { "enum": ["suspected", "quarantined"] }
            },
            "required": ["secretAssessment"]
          }
        },
        "required": ["artifact"]
      },
      "then": {
        "properties": {
          "admission": {
            "properties": {
              "status": { "const": "quarantined" },
              "reasonCodes": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reasonCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "artifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRef",
        "contentDigest",
        "byteCount",
        "mediaType",
        "encryptedAtRest",
        "classification",
        "secretAssessment"
      ],
      "properties": {
        "artifactRef": { "$ref": "#/$defs/identifier" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
        "mediaType": {
          "enum": ["application/json", "application/jsonl", "application/octet-stream", "application/parquet"]
        },
        "encryptedAtRest": { "const": true },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "secretAssessment": { "enum": ["none_detected", "suspected", "quarantined"] }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "rawPayloadEmbedded", "credentialValueEmbedded", "privateKeyEmbedded"],
      "properties": {
        "synthetic": { "type": "boolean" },
        "rawPayloadEmbedded": { "const": false },
        "credentialValueEmbedded": { "const": false },
        "privateKeyEmbedded": { "const": false }
      }
    }
  }
}
