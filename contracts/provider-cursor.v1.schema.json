{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativecertainty.github.io/pqc-migration-reference-demo/contracts/provider-cursor.v1.schema.json",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "ProviderCursor.v1",
  "description": "Versioned provider checkpoint receipt. Cursor values are sealed behind an opaque reference; this contract contains only their digest and ledger bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerCursorId",
    "tenantId",
    "integrationProfileRef",
    "scopeKey",
    "revision",
    "state",
    "cursorKind",
    "sealedPositionRef",
    "positionDigest",
    "predecessorCursorRef",
    "advancedBy",
    "observedAt",
    "committedAt",
    "safety"
  ],
  "properties": {
    "schemaVersion": { "const": "ProviderCursor.v1" },
    "providerCursorId": { "$ref": "#/$defs/identifier" },
    "tenantId": { "$ref": "#/$defs/identifier" },
    "integrationProfileRef": { "$ref": "#/$defs/identifier" },
    "scopeKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=.*\\S)[^\\r\\n\\t]+$"
    },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "state": { "enum": ["proposed", "committed", "invalidated"] },
    "cursorKind": { "enum": ["opaque_token", "timestamp", "page_number", "change_revision", "provider_event_id"] },
    "sealedPositionRef": { "$ref": "#/$defs/identifier" },
    "positionDigest": { "$ref": "#/$defs/digest" },
    "predecessorCursorRef": {
      "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
    },
    "advancedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectionRunRef", "sourceEventRef", "observationBatchRef"],
      "properties": {
        "collectionRunRef": { "$ref": "#/$defs/identifier" },
        "sourceEventRef": { "$ref": "#/$defs/identifier" },
        "observationBatchRef": { "$ref": "#/$defs/identifier" }
      }
    },
    "observedAt": { "$ref": "#/$defs/timestamp" },
    "committedAt": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "safety": { "$ref": "#/$defs/safety" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "committed" } },
        "required": ["state"]
      },
      "then": {
        "properties": { "committedAt": { "$ref": "#/$defs/timestamp" } }
      },
      "else": {
        "properties": { "committedAt": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "cursorValueEmbedded", "credentialValueEmbedded"],
      "properties": {
        "synthetic": { "type": "boolean" },
        "cursorValueEmbedded": { "const": false },
        "credentialValueEmbedded": { "const": false }
      }
    }
  }
}
