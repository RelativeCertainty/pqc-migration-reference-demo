{
  "name": "pqc-migration-reference-demo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "dotnet build apps/pqc-enterprise-demo/PqcEnterpriseDemo.csproj --no-restore -c Release -m:1 && npm --prefix apps/pqc-enterprise-demo/frontend run build",
    "typecheck": "npm --prefix apps/pqc-enterprise-demo/frontend run typecheck",
    "test": "npm --prefix apps/pqc-enterprise-demo/frontend test",
    "check": "python3 scripts/validate_reference.py",
    "start": "python3 scripts/start_reference.py",
    "dev": "python3 scripts/start_reference.py",
    "verify:public": "python3 scripts/verify_public_reference.py"
  }
}
