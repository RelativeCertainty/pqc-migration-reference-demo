{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upm.pba.io/schemas/common.ProductionAlignment.v1.schema.json",
  "title": "Production Alignment Common Definitions v1",
  "description": "Canonical closed value objects shared by strict production-alignment contracts. References are tenantless so tenant authority has one canonical source at the enclosing boundary.",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,255}$",
      "maxLength": 256
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$",
      "maxLength": 64
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "maxLength": 128
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "operationClass": {
      "type": "string",
      "enum": [
        "read",
        "inference",
        "retrieval",
        "communication",
        "mutation",
        "publication",
        "billing",
        "deployment",
        "signing"
      ]
    },
    "unitFamily": {
      "type": "string",
      "enum": [
        "model_input_token",
        "model_output_token",
        "model_call",
        "retrieval_operation",
        "retrieved_byte",
        "external_call",
        "egress_byte",
        "storage_byte_hour",
        "cpu_millisecond",
        "memory_mb_millisecond",
        "retry_attempt",
        "operator_second",
        "artifact_delivery",
        "accepted_outcome"
      ]
    },
    "authoritySourceType": {
      "type": "string",
      "enum": [
        "tenant",
        "agent",
        "agent_exposure",
        "principal_binding",
        "capability_spec",
        "manifest_current",
        "policy_bundle",
        "approval",
        "processing_record",
        "credential_binding",
        "control_binding",
        "model_route",
        "tool_route",
        "integration",
        "placement_contract",
        "usage_meter",
        "retention_policy",
        "containment_profile",
        "authority_time_profile",
        "signing_key_record",
        "trust_store",
        "execution_contract_cutover",
        "offering"
      ]
    },
    "signatureTargetType": {
      "type": "string",
      "enum": [
        "agent_authority_passport",
        "decision_receipt",
        "decision_receipt_publication",
        "policy_rule_pack",
        "agent_card_publication",
        "containment_run_evidence",
        "deletion_receipt",
        "deletion_tombstone_checkpoint",
        "run_audit_daily_root",
        "migration_anchor",
        "production_promotion_authority_compilation",
        "production_migration_fanout_compilation",
        "protected_ci_release_authority_compilation",
        "host_overlay_inventory"
      ]
    },
    "classification": {
      "type": "object",
      "properties": {
        "data_class": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "secret"
          ]
        },
        "data_sensitivity": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "operational",
              "pii",
              "phi",
              "financial",
              "auth_secret",
              "other_sensitive"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "regulatory_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "none",
              "gdpr",
              "ccpa",
              "hipaa",
              "multiple"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "data_class",
        "data_sensitivity",
        "regulatory_scope"
      ],
      "additionalProperties": false,
      "description": "Canonical classification; all three dimensions are mandatory in strict contracts."
    },
    "immutableRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "revision_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "content_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        },
        "schema_id": {
          "type": "string",
          "maxLength": 512,
          "format": "uri"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "revision_id",
        "content_sha256",
        "schema_id",
        "schema_version"
      ],
      "additionalProperties": false,
      "description": "Tenantless immutable revision reference. Tenant is supplied only by the enclosing authority boundary."
    },
    "entityRef": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "entity_kind": {
          "type": "string",
          "enum": [
            "agent",
            "human",
            "business",
            "tenant",
            "workload",
            "system"
          ]
        }
      },
      "required": [
        "entity_id",
        "entity_kind"
      ],
      "additionalProperties": false
    },
    "agentEntityRef": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "entity_kind": {
          "const": "agent"
        }
      },
      "required": [
        "entity_id",
        "entity_kind"
      ],
      "additionalProperties": false
    },
    "representedPrincipalRef": {
      "type": "object",
      "properties": {
        "entity_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "entity_kind": {
          "type": "string",
          "enum": [
            "human",
            "business"
          ]
        }
      },
      "required": [
        "entity_id",
        "entity_kind"
      ],
      "additionalProperties": false
    },
    "manifestMetadata": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/slug"
        },
        "version": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/semanticVersion"
        },
        "domain": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/slug"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "required": [
        "name",
        "version",
        "domain"
      ],
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "revision_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "content_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        },
        "classification": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/classification"
        },
        "content_type": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "maxLength": 127
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "encrypted": {
          "const": true
        }
      },
      "required": [
        "artifact_id",
        "revision_id",
        "content_sha256",
        "classification",
        "content_type",
        "bytes",
        "encrypted"
      ],
      "additionalProperties": false,
      "description": "Metadata-only artifact reference; content is never embedded."
    },
    "secretRef": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/slug"
        },
        "provider": {
          "const": "vault"
        },
        "vault_path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]{1,255}$"
        },
        "vault_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "metadata_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "name",
        "provider",
        "vault_path",
        "vault_key",
        "version",
        "metadata_sha256"
      ],
      "additionalProperties": false,
      "description": "Version-pinned Vault reference. Secret values and bearer material are not representable."
    },
    "sourceEpoch": {
      "type": "object",
      "properties": {
        "source_type": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/authoritySourceType"
        },
        "source_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "revision_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        },
        "deny_fenced": {
          "type": "boolean"
        }
      },
      "required": [
        "source_type",
        "source_id",
        "revision_id",
        "epoch",
        "content_sha256",
        "deny_fenced"
      ],
      "additionalProperties": false
    },
    "sourceEpochVector": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sourceEpoch"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "root_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "entries",
        "canonicalization",
        "root_sha256"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "scope_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "scope_type": {
          "type": "string",
          "enum": [
            "request",
            "run",
            "pipeline",
            "worker",
            "operation",
            "authority",
            "exposure",
            "agent",
            "tenant"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/reasonCode"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "resource_refs": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "classification_ceiling": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/classification"
        },
        "prohibited_effect_classes": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/operationClass"
          },
          "minItems": 0,
          "maxItems": 9,
          "uniqueItems": true
        }
      },
      "required": [
        "scope_id",
        "scope_type",
        "actions",
        "resource_refs",
        "classification_ceiling",
        "prohibited_effect_classes"
      ],
      "additionalProperties": false
    },
    "policyDecision": {
      "type": "object",
      "properties": {
        "decision_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "policy_bundle_ref": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
        },
        "input_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        },
        "grant_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256",
          "description": "Required only for an allow decision and equal to the resolved immutable grant content hash. Deny and error decisions cannot claim a grant."
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "error"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/reasonCode"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "evaluated_at": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/timestamp"
        }
      },
      "required": [
        "decision_id",
        "policy_bundle_ref",
        "input_sha256",
        "decision",
        "reason_codes",
        "evaluated_at",
        "expires_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "allow"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "grant_sha256"
            ]
          },
          "else": {
            "not": {
              "required": [
                "grant_sha256"
              ]
            }
          }
        }
      ]
    },
    "approvalDisposition": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "not_required"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/reasonCode"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "evidence_refs",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "unitLimit": {
      "type": "object",
      "properties": {
        "unit_family": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/unitFamily"
        },
        "maximum_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "unit_family",
        "maximum_units"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "unit_limits": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/unitLimit"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "maximum_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "currency": {
          "const": "USD"
        },
        "hard_limit": {
          "const": true
        }
      },
      "required": [
        "unit_limits",
        "maximum_microusd",
        "currency",
        "hard_limit"
      ],
      "additionalProperties": false
    },
    "timeReceipt": {
      "type": "object",
      "properties": {
        "authority_time_profile_ref": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
        },
        "evaluated_at": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/timestamp"
        },
        "uncertainty_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "synchronization_status": {
          "const": "healthy"
        },
        "receipt_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "authority_time_profile_ref",
        "evaluated_at",
        "uncertainty_ms",
        "synchronization_status",
        "receipt_sha256"
      ],
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "previous_revision_ref": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "canonical_content_sha256": {
          "description": "SHA-256 of the contract's canonical projection with this field and chain_sha256 omitted from the chain object; a contract-level self-hash field, when present, is also omitted and MUST equal this digest.",
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        },
        "chain_sha256": {
          "description": "SHA-256 chain value computed from the prior revision's chain digest and the canonical projection bytes under the contract's pinned chain profile.",
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "revision",
        "canonicalization",
        "canonical_content_sha256",
        "chain_sha256"
      ],
      "additionalProperties": false
    },
    "traceContext": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "correlation_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "idempotency_key_sha256": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "trace_id",
        "span_id",
        "correlation_id",
        "idempotency_key_sha256"
      ],
      "additionalProperties": false
    },
    "dispatchAttestation": {
      "type": "object",
      "properties": {
        "attestation_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "audience": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "runner_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "worker_revision_ref": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "release_digest": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/digest"
        },
        "runner_build_digest": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/digest"
        },
        "temporal_build_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "key_id": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/opaqueId"
        },
        "not_before": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/timestamp"
        },
        "jws_compact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "maxLength": 8192
        }
      },
      "required": [
        "attestation_id",
        "audience",
        "runner_id",
        "worker_revision_ref",
        "attempt",
        "release_digest",
        "runner_build_digest",
        "temporal_build_id",
        "key_id",
        "not_before",
        "expires_at",
        "jws_compact"
      ],
      "additionalProperties": false
    },
    "operationDisposition": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "completed",
            "failed",
            "reconciliation_pending",
            "compensated"
          ]
        },
        "receipt_refs": {
          "type": "array",
          "items": {
            "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "receipt_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_started"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "receipt_refs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "failed",
                  "reconciliation_pending",
                  "compensated"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "receipt_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "usageDisposition": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "reconciled",
            "reconciliation_pending"
          ]
        },
        "reservation_ref": {
          "$ref": "./common.ProductionAlignment.v1.schema.json#/$defs/immutableRef"
        },
