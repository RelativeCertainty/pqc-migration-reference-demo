{
  "name": "pqc-enterprise-demo-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node ../../../scripts/build_ui_manifest.mjs",
