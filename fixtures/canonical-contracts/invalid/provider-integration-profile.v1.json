  "dataHandling": {
    "classification": "internal",
    "rawEvidenceRetentionDays": 30,
    "encryptedArtifactRequired": true,
    "payloadLoggingAllowed": false
  },
  "status": "admitted",
  "evidenceStatus": "synthetic",
  "safety": { "synthetic": true, "credentialValueEmbedded": false, "privateKeyEmbedded": false, "rawPayloadEmbedded": false }
